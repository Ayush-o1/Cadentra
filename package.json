{
  "name": "cadentra",
  "version": "0.1.0",
  "private": true,
  "description": "Permission-based outbound email platform",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && rm -rf dist/public && cp -R src/public dist/public",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
