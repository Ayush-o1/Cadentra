# Copy to .env.production on the server. Never commit the real file.
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
APP_URL=https://app.example.org
# Generate each secret with: openssl rand -hex 32
APP_SECRET=
TRUST_PROXY=1
RUN_WORKER=true
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Used by docker-compose.prod.yml for the bundled MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
