# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# MySQL (matches docker-compose.yml)
DATABASE_URL=mysql://cadentra:cadentra@127.0.0.1:3307/cadentra

# Public base URL, used in unsubscribe links. Must be https in production.
APP_URL=http://localhost:3000

# At least 32 random characters. Generate with: openssl rand -hex 32
APP_SECRET=

# Set to true behind a reverse proxy so client IPs and secure cookies are detected correctly.
TRUST_PROXY=false

# Background worker
RUN_WORKER=true
WORKER_POLL_MS=5000
WORKER_CONCURRENCY=2
WORKER_MAX_SENDS_PER_SECOND=5
# Optional: enables POST /internal/tick for hosts that sleep. At least 24 characters.
TICK_TOKEN=

# Email provider: "fake" needs no credentials and simulates delivery locally.
EMAIL_PROVIDER=fake
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
