# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# MySQL (matches docker-compose.yml)
DATABASE_URL=mysql://cadentra:cadentra@127.0.0.1:3307/cadentra

# Public base URL, used in unsubscribe links. Must be https in production.
APP_URL=http://localhost:3000

# At least 32 random characters. Generate with: openssl rand -hex 32
APP_SECRET=

# How many reverse proxies sit in front of the app: false (none, local) or a number such as 1.
# Needed so client IPs and rate limits are correct behind a host like Render.
TRUST_PROXY=false

# Background worker
RUN_WORKER=true
WORKER_POLL_MS=5000
WORKER_CONCURRENCY=2
WORKER_MAX_SENDS_PER_SECOND=5
# How due messages are claimed. "skip-locked" is for MySQL 8. Use "conditional-update" on
# databases without SKIP LOCKED (TiDB). See docs/TIDB_COMPATIBILITY.md.
QUEUE_CLAIM_MODE=skip-locked
# Optional: enables POST /internal/tick for hosts that sleep. At least 24 characters.
TICK_TOKEN=

# Email provider: "fake" needs no credentials and simulates delivery locally.
EMAIL_PROVIDER=fake
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Sender of Cadentra's own mail (password reset, address confirmation). Required with "resend".
# SYSTEM_EMAIL_FROM=Cadentra <onboarding@resend.dev>
# Set to true to require a confirmed email address before a campaign can launch.
REQUIRE_VERIFIED_EMAIL=false
